{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/cloudphone-db.mjs deploy",
    "db:init": "wrangler d1 migrations apply cloudphone --local",
    "db:init:remote": "node scripts/cloudphone-db.mjs migrate",
    "db:migrate": "npm run db:init",
    "db:migrate:remote": "npm run db:init:remote",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test_bix.ts",
    "db:create-staff": "node scripts/cloudphone-db.mjs staff"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
